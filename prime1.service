[Unit]
Description=Prime1 IRC Bot
After=unrealircd.service anope.service
Wants=unrealircd.service

[Service]
User=prime1
Group=prime1
WorkingDirectory=/var/lib/prime1
ExecStart=/usr/bin/python3 /opt/prime1/prime1.py
EnvironmentFile=/etc/prime1/prime1.env
Restart=on-failure
RestartSec=30
StateDirectory=prime1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/prime1
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
